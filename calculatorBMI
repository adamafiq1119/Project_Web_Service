package org.calculatorBMI;

import javax.jws.WebService;
import javax.jws.WebMethod;
import javax.jws.WebParam;
import javax.xml.soap.SOAPException;
import javax.xml.ws.soap.SOAPFaultException;
import javax.xml.soap.SOAPFactory;
import javax.xml.soap.SOAPFault;

/**
 *
 * @author Hazwan
 */
@WebService(serviceName = "calculatorBMI")
public class calculatorBMI {

    /**
     * Web service operation
     */
    @WebMethod(operationName = "calculateBMI")
    public String calculateBMI(
            @WebParam(name = "weight") double weight, 
            @WebParam(name = "height") double height) throws SOAPException {
        
        // 1. Input Validation & SOAP Fault Handling
        if (weight <= 0 || height <= 0) {
            SOAPFault fault = SOAPFactory.newInstance().createFault();
            fault.setFaultString("Invalid Input: Weight and height must be greater than zero.");
            throw new SOAPFaultException(fault);
        }
        
        // 2. BMI Calculation
        // Assuming the client inputs height in centimeters (cm) and weight in kilograms (kg).
        // Convert height to meters for the BMI formula.
        double heightInMeters = height / 100.0;
        double bmi = weight / (heightInMeters * heightInMeters);
        
        // 3. Determine BMI Category
        String category;
        if (bmi < 18.5) {
            category = "Underweight";
        } else if (bmi >= 18.5 && bmi <= 24.9) {
            category = "Normal weight";
        } else if (bmi >= 25.0 && bmi <= 29.9) {
            category = "Overweight";
        } else {
            category = "Obese";
        }

        // 4. Detailed Output Return
        return "Your Body Mass Index (BMI) is: " + String.format("%.1f", bmi) + 
               ". Based on this value, your category is: " + category + ".";
    }
}
